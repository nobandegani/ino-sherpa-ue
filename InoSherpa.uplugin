{
	"FileVersion": 3,
	"EngineVersion": "5.8.0",
	"Version": 1,
	"VersionName": "1.0",
	"FriendlyName": "InoSherpa",
	"Description": "On-device speech via k2-fsa sherpa-onnx, statically linked: UInoTTS (text-to-speech) and UInoSTT (speech-to-text) game-instance subsystems with sync, async, and streaming APIs. Fully offline, no API keys. Win64 shipping; other platforms compile as graceful stubs. NOTE: the TTS path statically links GPL-3.0 espeak-ng and piper-phonemize, so distributed binaries including TTS are a combined work subject to GPL-3.0 - see README.",
	"Category": "Audio",
	"CreatedBy": "Inoland",
	"CreatedByURL": "https://github.com/nobandegani",
	"DocsURL": "https://github.com/nobandegani/ino-sherpa-ue#readme",
	"MarketplaceURL": "",
	"SupportURL": "https://github.com/nobandegani/ino-sherpa-ue/issues",
	"CanContainContent": true,
	"IsBetaVersion": false,
	"IsExperimentalVersion": false,
	"Installed": false,
	"Modules": [
		{
			"Name": "InoSherpa",
			"Type": "Runtime",
			"LoadingPhase": "Default"
		}
	],
	"Plugins": [
		{
			"Name": "InoNodes",
			"Enabled": true
		}
	]
