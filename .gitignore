# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# --- InoSherpa additions ---
# Staged sherpa-onnx static libs are NOT committed (unlike the sibling
# plugins' staged outputs): onnxruntime.lib alone is ~685 MB, which is
# over GitHub's 100 MB hard limit. setup-sherpa-onnx.ps1 restores them
# deterministically from the pinned release; the template's *.lib glob
# above already keeps them out. The idempotency stamp stays untracked
# for the same reason.
Source/ThirdParty/.sherpa_version

# Setup download cache + dev models — populated by the SherpaOnnx/scripts/
# scripts, safe to wipe, never committed.
SherpaOnnx/.cache/
SherpaOnnx/models/
